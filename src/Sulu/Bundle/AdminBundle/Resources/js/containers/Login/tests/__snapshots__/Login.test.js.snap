            style="width: 20px; height: 20px;"
          >
            <div
              class="doubleBounce1"
            />
            <div
              class="doubleBounce2"
            />
          </div>
        </div>
      </div>
      <div
        class="backLinkContainer"
      />
    </div>
  </div>
</DocumentFragment>
`;
