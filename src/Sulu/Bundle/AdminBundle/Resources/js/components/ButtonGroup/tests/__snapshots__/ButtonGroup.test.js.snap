              x="14"
              y="3"
            />
            <rect
              height="7"
              rx="1"
              width="7"
              x="14"
              y="14"
            />
            <rect
              height="7"
              rx="1"
              width="7"
              x="3"
              y="14"
            />
          </svg>
        </span>
      </span>
    </button>
    <button
      class="button icon button"
      type="button"
    >
      <span
        aria-label="su-angle-down"
        class="svgIcon su-angle-down dropdownIcon"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-chevron-down"
          fill="none"
          focusable="false"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.75"
          viewBox="0 0 24 24"
        >
          <path
            d="m6 9 6 6 6-6"
          />
        </svg>
      </span>
    </button>
  </div>
</div>
`;

