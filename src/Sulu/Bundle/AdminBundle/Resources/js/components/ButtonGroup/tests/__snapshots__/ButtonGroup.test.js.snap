exports[`Should render a button and a dropdown button 1`] = `
<div>
  <div
    class="buttonGroup"
  >
    <button
      class="button icon hasText button"
      type="button"
    >
      <span
        class="buttonText"
      >
        <span
          aria-label="su-th-large"
          class="svgIcon su-th-large"
        >
